// =====================================================
// 旅游聚合网站 Prisma Schema
// 数据库: PostgreSQL (Supabase)
// =====================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// 枚举类型定义
// =====================================================

enum TransactionType {
  DEPOSIT    // 充值
  WITHDRAW   // 提现
  PAYMENT    // 支付
  REFUND     // 退款
  EXCHANGE   // 兑换
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum AttractionCategory {
  MUSEUM
  PALACE
  PARK
  GALLERY
  HISTORICAL_SITE
  OTHER
}

enum TicketType {
  ADULT
  CHILD
  STUDENT
  SENIOR
  FAMILY
  GROUP
}

enum PerformanceGenre {
  BALLET
  OPERA
  DRAMA
  CONCERT
  MUSICAL
  OTHER
}

enum ShowStatus {
  SELLING
  SOLD_OUT
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
}

enum ExchangeServiceType {
  BANK_TRANSFER  // 银行转账
  PURCHASE       // 代买商品
  CASH          // 现金兑换
}

enum OrderType {
  ATTRACTION  // 景点门票
  THEATER     // 剧院门票
  EXCHANGE    // 兑换服务
}

enum OrderStatus {
  PENDING     // 待支付
  PAID        // 已支付
  CONFIRMED   // 已确认
  COMPLETED   // 已完成
  CANCELLED   // 已取消
  REFUNDED    // 已退款
}

enum PaymentMethod {
  BALANCE  // 余额
  CRYPTO   // 加密货币
}

enum ExchangeOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// =====================================================
// 用户和账户管理
// =====================================================

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(255)
  phone               String?              @db.VarChar(50)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  fullName            String?              @map("full_name") @db.VarChar(255)
  avatarUrl           String?              @map("avatar_url") @db.Text
  preferredLanguage   String               @default("zh-CN") @map("preferred_language") @db.VarChar(10)
  preferredCurrency   String               @default("CNY") @map("preferred_currency") @db.VarChar(10)
  isVerified          Boolean              @default(false) @map("is_verified")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  cryptoWallets       CryptoWallet[]
  balances            UserBalance[]
  transactions        BalanceTransaction[]
  orders              Order[]
  exchangeOrders      ExchangeOrder[]
  auditLogs           AuditLog[]
  lockedSeats         ShowSeatPrice[]      @relation("LockedByUser")

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model CryptoWallet {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  walletAddress         String   @unique @map("wallet_address") @db.VarChar(255)
  walletType            String   @default("USDT-TRC20") @map("wallet_type") @db.VarChar(50)
  encryptedPrivateKey   String?  @map("encrypted_private_key") @db.Text
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletAddress])
  @@map("crypto_wallets")
}

model UserBalance {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  currency          String   @db.VarChar(10)
  availableBalance  Decimal  @default(0.00) @map("available_balance") @db.Decimal(20, 2)
  frozenBalance     Decimal  @default(0.00) @map("frozen_balance") @db.Decimal(20, 2)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@index([userId])
  @@map("user_balances")
}

model BalanceTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  transactionType TransactionType   @map("transaction_type")
  currency        String            @db.VarChar(10)
  amount          Decimal           @db.Decimal(20, 2)
  balanceBefore   Decimal           @map("balance_before") @db.Decimal(20, 2)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(20, 2)
  relatedOrderId  String?           @map("related_order_id") @db.Uuid
  cryptoTxHash    String?           @map("crypto_tx_hash") @db.VarChar(255)
  status          TransactionStatus @default(PENDING)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("balance_transactions")
}

// =====================================================
// 地理位置和城市
// =====================================================

model City {
  id            String    @id @default(uuid()) @db.Uuid
  nameZh        String    @map("name_zh") @db.VarChar(255)
  nameEn        String    @map("name_en") @db.VarChar(255)
  nameLocal     String?   @map("name_local") @db.VarChar(255)
  countryCode   String    @map("country_code") @db.VarChar(2)
  timezone      String    @db.VarChar(50)
  latitude      Decimal?  @db.Decimal(10, 8)
  longitude     Decimal?  @db.Decimal(11, 8)
  description   String?   @db.Text
  imageUrl      String?   @map("image_url") @db.Text
  isFeatured    Boolean   @default(false) @map("is_featured")
  displayOrder  Int       @default(0) @map("display_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  attractions Attraction[]
  theaters    Theater[]

  @@index([countryCode])
  @@index([isFeatured, displayOrder])
  @@map("cities")
}

// =====================================================
// 景点门票系统
// =====================================================

model Attraction {
  id                  String              @id @default(uuid()) @db.Uuid
  cityId              String              @map("city_id") @db.Uuid
  nameZh              String              @map("name_zh") @db.VarChar(255)
  nameEn              String              @map("name_en") @db.VarChar(255)
  nameLocal           String?             @map("name_local") @db.VarChar(255)
  description         String?             @db.Text
  address             String?             @db.Text
  latitude            Decimal?            @db.Decimal(10, 8)
  longitude           Decimal?            @db.Decimal(11, 8)
  openingHours        Json?               @map("opening_hours")
  closedDays          Json?               @map("closed_days")
  advanceBookingDays  Int                 @default(10) @map("advance_booking_days")
  images              Json?
  category            AttractionCategory?
  isFeatured          Boolean             @default(false) @map("is_featured")
  displayOrder        Int                 @default(0) @map("display_order")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  city     City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  sections AttractionSection[]

  @@index([cityId])
  @@index([category])
  @@index([isFeatured, displayOrder])
  @@map("attractions")
}

model AttractionSection {
  id                  String                   @id @default(uuid()) @db.Uuid
  attractionId        String                   @map("attraction_id") @db.Uuid
  nameZh              String                   @map("name_zh") @db.VarChar(255)
  nameEn              String                   @map("name_en") @db.VarChar(255)
  description         String?                  @db.Text
  durationMinutes     Int?                     @map("duration_minutes")
  hasTimeSlot         Boolean                  @default(true) @map("has_time_slot")
  timeSlotInterval    Int                      @default(30) @map("time_slot_interval")
  maxCapacityPerSlot  Int?                     @map("max_capacity_per_slot")
  displayOrder        Int                      @default(0) @map("display_order")
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  attraction       Attraction                @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  ticketPrices     AttractionTicketPrice[]
  inventory        AttractionInventory[]
  orderItems       OrderAttractionItem[]

  @@index([attractionId])
  @@map("attraction_sections")
}

model AttractionTicketPrice {
  id          String      @id @default(uuid()) @db.Uuid
  sectionId   String      @map("section_id") @db.Uuid
  ticketType  TicketType  @map("ticket_type")
  price       Decimal     @db.Decimal(10, 2)
  currency    String      @db.VarChar(10)
  description String?     @db.Text
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  section    AttractionSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderItems OrderAttractionItem[]

  @@index([sectionId])
  @@map("attraction_ticket_prices")
}

model AttractionInventory {
  id                String   @id @default(uuid()) @db.Uuid
  sectionId         String   @map("section_id") @db.Uuid
  visitDate         DateTime @map("visit_date") @db.Date
  timeSlot          DateTime? @map("time_slot") @db.Time(6)
  availableQuantity Int      @map("available_quantity")
  soldQuantity      Int      @default(0) @map("sold_quantity")
  isAvailable       Boolean  @default(true) @map("is_available")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  section AttractionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, visitDate, timeSlot])
  @@index([sectionId, visitDate])
  @@index([visitDate])
  @@map("attraction_inventory")
}

// =====================================================
// 剧院票务系统
// =====================================================

model Theater {
  id           String   @id @default(uuid()) @db.Uuid
  cityId       String   @map("city_id") @db.Uuid
  nameZh       String   @map("name_zh") @db.VarChar(255)
  nameEn       String   @map("name_en") @db.VarChar(255)
  nameLocal    String?  @map("name_local") @db.VarChar(255)
  description  String?  @db.Text
  address      String?  @db.Text
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  images       Json?
  isFeatured   Boolean  @default(false) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  city  City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  halls TheaterHall[]

  @@index([cityId])
  @@map("theaters")
}

model TheaterHall {
  id         String   @id @default(uuid()) @db.Uuid
  theaterId  String   @map("theater_id") @db.Uuid
  nameZh     String   @map("name_zh") @db.VarChar(255)
  nameEn     String   @map("name_en") @db.VarChar(255)
  totalSeats Int      @map("total_seats")
  seatLayout Json?    @map("seat_layout")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  theater      Theater       @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  seats        TheaterSeat[]
  performances Performance[]

  @@index([theaterId])
  @@map("theater_halls")
}

model TheaterSeat {
  id            String   @id @default(uuid()) @db.Uuid
  hallId        String   @map("hall_id") @db.Uuid
  rowName       String   @map("row_name") @db.VarChar(10)
  seatNumber    String   @map("seat_number") @db.VarChar(10)
  zone          String?  @db.VarChar(50)
  xPosition     Int?     @map("x_position")
  yPosition     Int?     @map("y_position")
  isWheelchair  Boolean  @default(false) @map("is_wheelchair")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  hall       TheaterHall       @relation(fields: [hallId], references: [id], onDelete: Cascade)
  seatPrices ShowSeatPrice[]
  orderItems OrderTheaterItem[]

  @@unique([hallId, rowName, seatNumber])
  @@index([hallId])
  @@index([hallId, zone])
  @@map("theater_seats")
}

model Performance {
  id              String            @id @default(uuid()) @db.Uuid
  hallId          String            @map("hall_id") @db.Uuid
  titleZh         String            @map("title_zh") @db.VarChar(255)
  titleEn         String            @map("title_en") @db.VarChar(255)
  description     String?           @db.Text
  genre           PerformanceGenre?
  director        String?           @db.VarChar(255)
  cast            Json?
  durationMinutes Int?              @map("duration_minutes")
  language        String?           @db.VarChar(50)
  hasSubtitles    Boolean           @default(false) @map("has_subtitles")
  subtitleLanguage String?          @map("subtitle_language") @db.VarChar(50)
  images          Json?
  videoUrl        String?           @map("video_url") @db.Text
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  hall  TheaterHall      @relation(fields: [hallId], references: [id], onDelete: Cascade)
  shows PerformanceShow[]

  @@index([hallId])
  @@index([genre])
  @@map("performances")
}

model PerformanceShow {
  id            String     @id @default(uuid()) @db.Uuid
  performanceId String     @map("performance_id") @db.Uuid
  showDate      DateTime   @map("show_date") @db.Date
  showTime      DateTime   @map("show_time") @db.Time(6)
  status        ShowStatus @default(SELLING)
  notes         String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  performance Performance         @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  seatPrices  ShowSeatPrice[]
  orderItems  OrderTheaterItem[]

  @@index([performanceId])
  @@index([showDate])
  @@map("performance_shows")
}

model ShowSeatPrice {
  id             String      @id @default(uuid()) @db.Uuid
  showId         String      @map("show_id") @db.Uuid
  seatId         String      @map("seat_id") @db.Uuid
  zone           String?     @db.VarChar(50)
  price          Decimal     @db.Decimal(10, 2)
  currency       String      @db.VarChar(10)
  status         SeatStatus  @default(AVAILABLE)
  lockedUntil    DateTime?   @map("locked_until") @db.Timestamptz(6)
  lockedByUserId String?     @map("locked_by_user_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  show         PerformanceShow    @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat         TheaterSeat        @relation(fields: [seatId], references: [id], onDelete: Cascade)
  lockedByUser User?              @relation("LockedByUser", fields: [lockedByUserId], references: [id])
  orderItems   OrderTheaterItem[]

  @@unique([showId, seatId])
  @@index([showId])
  @@index([showId, status])
  @@index([showId, zone])
  @@map("show_seat_prices")
}

// =====================================================
// 兑换服务系统
// =====================================================

model ExchangeService {
  id                 String                @id @default(uuid()) @db.Uuid
  serviceType        ExchangeServiceType   @map("service_type")
  nameZh             String                @map("name_zh") @db.VarChar(255)
  nameEn             String                @map("name_en") @db.VarChar(255)
  description        String?               @db.Text
  baseFeePercentage  Decimal               @map("base_fee_percentage") @db.Decimal(5, 4)
  minFeeAmount       Decimal?              @map("min_fee_amount") @db.Decimal(10, 2)
  maxFeeAmount       Decimal?              @map("max_fee_amount") @db.Decimal(10, 2)
  displayOrder       Int                   @default(0) @map("display_order")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  currencyFees   ExchangeCurrencyFee[]
  exchangeOrders ExchangeOrder[]

  @@index([serviceType])
  @@map("exchange_services")
}

model ExchangeCurrencyFee {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  fromCurrency     String   @map("from_currency") @db.VarChar(10)
  toCurrency       String   @map("to_currency") @db.VarChar(10)
  feePercentage    Decimal  @map("fee_percentage") @db.Decimal(5, 4)
  markupPercentage Decimal  @default(0.00) @map("markup_percentage") @db.Decimal(5, 4)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  service ExchangeService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, fromCurrency, toCurrency])
  @@index([serviceId])
  @@map("exchange_currency_fees")
}

model ExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  fromCurrency String   @map("from_currency") @db.VarChar(10)
  toCurrency   String   @map("to_currency") @db.VarChar(10)
  rate         Decimal  @db.Decimal(18, 8)
  source       String?  @db.VarChar(50)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, fetchedAt])
  @@index([fromCurrency, toCurrency])
  @@index([fetchedAt(sort: Desc)])
  @@map("exchange_rates")
}

model ExchangeOrder {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  serviceId    String                @map("service_id") @db.Uuid
  fromCurrency String                @map("from_currency") @db.VarChar(10)
  toCurrency   String                @map("to_currency") @db.VarChar(10)
  fromAmount   Decimal               @map("from_amount") @db.Decimal(20, 2)
  exchangeRate Decimal               @map("exchange_rate") @db.Decimal(18, 8)
  toAmount     Decimal               @map("to_amount") @db.Decimal(20, 2)
  feeAmount    Decimal               @map("fee_amount") @db.Decimal(20, 2)
  finalAmount  Decimal               @map("final_amount") @db.Decimal(20, 2)
  status       ExchangeOrderStatus   @default(PENDING)
  notes        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?             @map("completed_at") @db.Timestamptz(6)

  // 关系
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service ExchangeService @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("exchange_orders")
}

// =====================================================
// 订单系统
// =====================================================

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  orderNumber     String         @unique @map("order_number") @db.VarChar(50)
  userId          String         @map("user_id") @db.Uuid
  orderType       OrderType      @map("order_type")
  totalAmount     Decimal        @map("total_amount") @db.Decimal(20, 2)
  currency        String         @db.VarChar(10)
  paymentAmount   Decimal        @map("payment_amount") @db.Decimal(20, 2)
  paymentCurrency String         @map("payment_currency") @db.VarChar(10)
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod? @map("payment_method")
  contactName     String?        @map("contact_name") @db.VarChar(255)
  contactPhone    String?        @map("contact_phone") @db.VarChar(50)
  contactEmail    String?        @map("contact_email") @db.VarChar(255)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz(6)
  confirmedAt     DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(6)

  // 关系
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attractionItems OrderAttractionItem[]
  theaterItems    OrderTheaterItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderAttractionItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  sectionId     String   @map("section_id") @db.Uuid
  ticketPriceId String   @map("ticket_price_id") @db.Uuid
  visitDate     DateTime @map("visit_date") @db.Date
  timeSlot      DateTime? @map("time_slot") @db.Time(6)
  quantity      Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  currency      String   @db.VarChar(10)
  visitorInfo   Json?    @map("visitor_info")
  ticketCodes   Json?    @map("ticket_codes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  section     AttractionSection     @relation(fields: [sectionId], references: [id])
  ticketPrice AttractionTicketPrice @relation(fields: [ticketPriceId], references: [id])

  @@index([orderId])
  @@index([visitDate])
  @@map("order_attraction_items")
}

model OrderTheaterItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  showId       String   @map("show_id") @db.Uuid
  seatId       String   @map("seat_id") @db.Uuid
  seatPriceId  String   @map("seat_price_id") @db.Uuid
  rowName      String   @map("row_name") @db.VarChar(10)
  seatNumber   String   @map("seat_number") @db.VarChar(10)
  zone         String?  @db.VarChar(50)
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @db.VarChar(10)
  visitorName  String?  @map("visitor_name") @db.VarChar(255)
  ticketCode   String?  @map("ticket_code") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  show      PerformanceShow @relation(fields: [showId], references: [id])
  seat      TheaterSeat     @relation(fields: [seatId], references: [id])
  seatPrice ShowSeatPrice   @relation(fields: [seatPriceId], references: [id])

  @@index([orderId])
  @@index([showId])
  @@map("order_theater_items")
}

// =====================================================
// 系统配置和日志
// =====================================================

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_configs")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  action       String    @db.VarChar(100)
  resourceType String?   @map("resource_type") @db.VarChar(50)
  resourceId   String?   @map("resource_id") @db.Uuid
  oldValue     Json?     @map("old_value")
  newValue     Json?     @map("new_value")
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
