generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  wechatId      String?   // Optional, but one of wechat/telegram is required
  telegramId    String?   // Optional, but one of wechat/telegram is required
  phoneNumber   String    // Required
  role          String    @default("user") // "user" | "admin"
  balance       Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet        Wallet?
  orders        Order[]
  transactions  Transaction[]
}


model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  address         String   @unique
  encryptedMnemonic String // Encrypted 12-word mnemonic
  iv              String   // Initialization Vector for encryption
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
}

enum ProductType {
  VIRTUAL
  ATTRACTION
  THEATER
  CONCIERGE
  AUTO_DELIVERY
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  titleZh     String?
  titleRu     String?
  descriptionZh String?
  descriptionRu String?
  
  price       Float
  image       String?  // Product image URL
  stock       Int      @default(0)
  content     String?  // The virtual good content (e.g. code/link), hidden until purchase
  currency    String   @default("RUB")
  
  type            ProductType @default(VIRTUAL)
  location        String?     // General location or Theater Name
  venue           String?     // Specific hall/room
  city            String?     // City filter
  cityZh          String?
  cityRu          String?

  googleMapLink   String?
  yandexMapLink   String?

  attractionId    String?
  attraction      Attraction? @relation(fields: [attractionId], references: [id])

  availableSlots  Json?       // For Attraction date/time configuration
  slotTimes       Json?       // Array of daily entry times, e.g. ["10:00", "11:00", "13:30", "14:30"]
  conciergeFields Json?       // Dynamic form inputs for concierge products
  markupRules     Json?       // Tiered pricing markup rules
  
  // Auto-delivery configuration
  autoDeliveryType String?     // "FIXED" | "POOL" | "API"
  cdkPool          Json?       // Array of CDK strings, e.g. ["cdk1", "cdk2"]
  apiDeliveryUrl   String?     // External API URL for dynamic delivery
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Attraction {
  id            String   @id @default(cuid())
  name          String
  nameZh        String?
  nameRu        String?
  description   String?
  descriptionZh String?
  descriptionRu String?
  
  city          String
  cityZh        String?
  cityRu        String?
  
  image         String?
  googleMapLink String?
  yandexMapLink String?
  
  // Slot configuration policies
  bookingWindow Int?      @default(10) // number of days to sell, e.g. 10, 14, 20
  closedDays    Json?     // Array of rest days in week, e.g. [2, 4] for Tue/Thu. 0=Sun, 1=Mon, 2=Tue...
  slotInterval  Int?      @default(60) // in minutes
  startTime     String?   @default("09:00")
  endTime       String?   @default("18:00")
  slotsUpdatedAt DateTime? // timestamp of last slot sync

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  productId String
  status    String   @default("pending") // "pending" | "paid" | "completed"
  price     Float    // Snapshot of price at purchase
  deliveryContent String? // Manual link/content sent by admin
  
  // Type-specific user inputs
  bookingDate     DateTime?   // For Tickets (Attraction/Theater)
  targetLink      String?     // For Concierge service
  additionalInfo  String?     // Generic notes
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  txHash    String   @unique
  amount    Float
  asset     String   // "USDT" | "USDC"
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}


