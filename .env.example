# =====================================================
# Shopping E-Commerce Environment Configuration
# Backend: Supabase (PostgreSQL)
# =====================================================

# Database (Supabase PostgreSQL)
# DATABASE_URL: Supabase Transaction Connection Pooler (port 5432 or 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Direct Connection URL for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_a_random_32_character_string"

# HD Wallet & Encryption (Crypto Deposits)
MASTER_MNEMONIC="twelve word seed phrase for hd wallet generation..."
WALLET_SECRET="64_character_hex_encryption_secret_key"

# Blockchain RPC (Binance Smart Chain)
BSC_RPC_URL="https://bsc-dataseed.binance.org/"

# SMTP Email Configuration
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
